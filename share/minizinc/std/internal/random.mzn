function float: uniform(float: lowerbound, float: upperbound) =
	uniform_internal_float(lowerbound, upperbound);
function int: uniform(int: lowerbound, int: upperbound) =
	uniform_internal_int(lowerbound, upperbound);

function float: uniform_internal_float(float: lowerbound, float: upperbound);
function int: uniform_internal_int(int: lowerbound, int: upperbound);
