<instance format="XCSP3" type="CSP">
  <variables>
    <array id="x" size="[3]"> 0..4 </array>
    <array id="y" size="[3]"> 0..4 </array>
    <array id="z" size="[3]"> 0..8 </array>
  </variables>
  <constraints>
    <slide id="c4">
      <list offset="2" collect="2"> x[0] y[0] x[1] y[1] x[2] y[2] </list>
      <list> z[0] z[1] z[2] </list>
      <intension> eq(add(%0,%1),%2) </intension>
    </slide>
  </constraints>
</instance>
