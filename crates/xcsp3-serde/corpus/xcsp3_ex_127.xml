<instance format="XCSP3" type="CSP">
  <variables>
    <array id="x" size="[4]"> 0..4 </array>
    <array id="y" size="[4]"> 0..2 </array>
    <array id="w" size="[3]"> 0..4 </array>
    <array id="z" size="[3]"> 0..4 </array>
  </variables>
  <constraints>
    <slide id="c1">
      <list> x[0] x[1] x[2] x[3] </list>
      <intension> eq(add(%0,%1),%2) </intension>
    </slide>
    <slide id="c2" circular="true">
      <list> y[0] y[1] y[2] y[3] </list>
      <extension>
        <list> %0 %1 </list>
        <supports> (0,0)(0,2)(1,1)(2,0)(2,1) </supports>
      </extension>
    </slide>
    <slide id="c3">
      <list offset="2"> w[0] z[0] w[1] z[1] w[2] z[2] </list>
      <intension> ne(%0,%1) </intension>
    </slide>
  </constraints>
</instance>
