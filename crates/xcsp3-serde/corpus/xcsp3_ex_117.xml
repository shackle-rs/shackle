<instance format="XCSP3" type="CSP">
  <variables>
    <array id="x" size="[3][3]"> 0..9 </array>
    <var id="i"> 0..2 </var>
    <var id="j"> 0..2 </var>
  </variables>
  <constraints>
    <element>
      <matrix>
        x[][]
      </matrix>
      <index> i j </index>
      <condition> (eq,5) </condition>
    </element>
  </constraints>
</instance>
