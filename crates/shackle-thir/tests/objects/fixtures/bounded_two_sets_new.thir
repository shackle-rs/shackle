enum A_potential = A_occ_0('..'(1, n)) ++ A_occ_1('..'(1, m));
array [int] of record(var '..'(0, 2): c): A_objects = '++'(A_as1_objects, A_as2_objects);
var set of A_potential: A = array_union([as1_ref, as2_ref]);
array [A_potential] of string: A_ids = array1d(A_potential, '++'(['++'('++'("as1[", show(p)), "]") | p in '..'(1, card('..'(1, n)))], ['++'('++'("as2[", show(p)), "]") | p in '..'(1, card('..'(1, m)))]));
int: n;
array ['..'(1, n)] of record(var '..'(0, 2): c): A_as1_storage;
array [int] of record(var '..'(0, 2): c): A_as1_objects = A_as1_storage;
var set( '..'(1, n) ) of  A_occ_0('..'(1, n)): as1_ref :: (no_output);
int: m;
array ['..'(1, m)] of record(var '..'(0, 2): c): A_as2_storage;
array [int] of record(var '..'(0, 2): c): A_as2_objects = A_as2_storage;
var set( '..'(1, m) ) of  A_occ_1('..'(1, m)): as2_ref :: (no_output);
constraint forall(['\/'('in'(x, A), '='(('[]'(A_objects, enum2int(x))).c, mzn_safe_default(('[]'(A_objects, enum2int(x))).c))) | x in A_potential]);
array [int] of record(int: c, string: id): as1 :: (output_only) :: ('output') = [(id: '[]'(A_ids, _DECL_1), c: fix(('[]'(A_objects, enum2int(_DECL_1))).c)) | _DECL_1 in fix(as1_ref)];
array [int] of record(int: c, string: id): as2 :: (output_only) :: ('output') = [(id: '[]'(A_ids, _DECL_2), c: fix(('[]'(A_objects, enum2int(_DECL_2))).c)) | _DECL_2 in fix(as2_ref)];
solve satisfy;
