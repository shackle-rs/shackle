enum A_potential = A_occ_0('..'(1, 2));
array [int] of record(var '..'(1, 3): x): A_objects = A_as_objects;
var set of A_potential: A = as_ref;
array [A_potential] of string: A_ids = array1d(A_potential, ['++'('++'("as[", show(p)), "]") | p in '..'(1, card('..'(1, 2)))]);
array ['..'(1, 2)] of record(var '..'(1, 3): x): A_as_storage;
array [int] of record(var '..'(1, 3): x): A_as_objects = [(x: x) | p in index_set(A_as_storage), input = '[]'(A_as_storage, p), x = (input).x];
var set( '..'(1, 2) ) of  A_occ_0('..'(1, 2)): as_ref :: (no_output);
array [A_potential] of var '..'(0, 10): scores_ref :: (no_output);
constraint forall(['>='('[]'(scores_ref, a), ('[]'(A_objects, enum2int(a))).x) | a in A]);
output [show(fix(scores_ref)), " ", show(['[]'(A_ids, _DECL_1) | _DECL_1 in fix(as_ref)])];
constraint forall(['\/'('in'(x, A), '='(('[]'(A_objects, enum2int(x))).x, mzn_safe_default(('[]'(A_objects, enum2int(x))).x))) | x in A_potential]);
array [int] of record(string: id, int: x): as :: (output_only) :: ('output') = [(id: '[]'(A_ids, _DECL_2), x: fix(('[]'(A_objects, enum2int(_DECL_2))).x)) | _DECL_2 in fix(as_ref)];
array [A_potential] of int: scores :: (output_only) :: ('output') = fix(scores_ref);
solve satisfy;
