enum A_potential = A_occ_0({1, 2});
array [int] of record('..'(1, 2): key, array ['..'(1, 3)] of var '..'(0, 2): xs): A_objects = A_as_objects;
set of A_potential: A = as;
array [A_potential] of string: A_ids = array1d(A_potential, ['++'('++'("as[", show(p)), "]") | p in '..'(1, card({1, 2}))]);
array [int] of record(int: key): A_as_inputs = [(key: 1), (key: 2)];
int: A_as_root_start = 1;
int: A_as_root_end = 3;
array [int] of record('..'(1, 2): key, array ['..'(1, 3)] of var '..'(0, 2): xs): A_as_objects = [(key: key, xs: xs) | p in index_set(A_as_inputs), input = '[]'(A_as_inputs, p), key = (input).key, xs = let {
  array ['..'(1, 3)] of var '..'(0, 2): xs_init;
} in xs_init];
set of A_occ_0({1, 2}): as = A_occ_0({1, 2});
var A: chosen_ref :: (no_output);
var '..'(1, 2): cid;
constraint '='(sum([sum(('[]'(A_objects, enum2int(a))).xs) | a in as]), 1);
constraint forall(['->'('='(('[]'(A_objects, enum2int(a))).key, 2), '='(sum(('[]'(A_objects, enum2int(a))).xs), 0)) | a in as]);
constraint '='(sum(('[]'(A_objects, enum2int(chosen_ref))).xs), 1);
constraint '='(cid, ('[]'(A_objects, enum2int(chosen_ref))).key);
output ["cid=", show(fix(cid)), " sums=", show([sum(fix(('[]'(A_objects, enum2int(a))).xs)) | a in as])];
string: chosen :: (output_only) :: ('output') = '[]'(A_ids, fix(chosen_ref));
solve satisfy;
