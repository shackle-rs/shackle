enum N_potential = N_occ_2('..'(1, '*'(card(P_potential), max('..'(0, 1)))));
array [int] of record(var '..'(0, 1): v): N_objects = array1d(N_ps_ns_objects);
var set of N_potential: N = array_union([if 'in'(_DECL_1, P) then ('[]'(P_ps_objects, _DECL_1)).ns else {} endif | _DECL_1 in index_set(P_ps_objects)]);
enum P_potential = P_occ_1('..'(1, '*'(card(C_potential), max('..'(1, 1)))));
array [int] of record(var set of N_potential: ns): P_objects = array1d(P_ps_objects);
var set of P_potential: P = array_union([('[]'(C_c_objects, _DECL_2)).ps | _DECL_2 in index_set(C_c_objects)]);
constraint forall(['in'(card(('[]'(P_objects, enum2int(this))).ns), '..'(0, 1)) | this in P]);
enum C_potential = C_occ_0({1});
array [int] of record(var set of P_potential: ps): C_objects = C_c_objects;
set of C_potential: C = C_occ_0({1});
constraint forall(['in'(card(('[]'(C_objects, enum2int(this))).ps), '..'(1, 1)) | this in C]);
array [{1}] of record(var set of P_potential: ps): C_c_storage;
array [P_occ_1('..'(1, '*'(card(C_potential), max('..'(1, 1)))))] of record(var set of N_potential: ns): P_ps_objects;
array [N_occ_2('..'(1, '*'(card(P_potential), max('..'(0, 1)))))] of record(var '..'(0, 1): v): N_ps_ns_objects;
int: C_c_ps_ns_start = 1;
int: C_c_ps_ns_end = '+'(C_c_ps_ns_start, '*'(card(P_potential), max('..'(0, 1))));
array [P_occ_1('..'(1, '*'(card(C_potential), max('..'(1, 1)))))] of set of N_potential: C_c_ps_ns_potential = [_DECL_3: N_occ_2('..'('+'(1, '*'('-'(enum2int(_DECL_3), 1), max('..'(0, 1)))), '*'(enum2int(_DECL_3), max('..'(0, 1))))) | _DECL_3 in index_set(P_ps_objects)];
int: C_c_ps_start = 1;
int: C_c_ps_end = '+'(C_c_ps_start, '*'(card(C_potential), max('..'(1, 1))));
array [int] of set of P_potential: C_c_ps_potential = [_DECL_4: P_occ_1('..'('+'(1, '*'('-'(_DECL_4, 1), max('..'(1, 1)))), '*'(_DECL_4, max('..'(1, 1))))) | _DECL_4 in index_set(C_c_storage)];
array [int] of record(var set of P_potential: ps): C_c_objects = [(ps: ps) | p in index_set(C_c_storage), input = '[]'(C_c_storage, p), ps = (input).ps];
C_potential: c = C_occ_0(1);
constraint forall(['subset'(enum2int(('[]'(C_c_objects, _DECL_5)).ps), enum2int('[]'(C_c_ps_potential, _DECL_5))) | _DECL_5 in index_set(C_c_objects)]);
constraint forall(['subset'(enum2int(('[]'(P_ps_objects, _DECL_6)).ns), enum2int('[]'(C_c_ps_ns_potential, _DECL_6))) | _DECL_6 in index_set(P_ps_objects)]);
constraint forall(['='(card(('[]'(P_objects, enum2int(p))).ns), 0) | cc in C, p in ('[]'(C_objects, enum2int(cc))).ps]);
output ["nN=", show(card(fix(N))), " nP=", show(card(fix(P)))];
constraint forall(['\/'('in'(x, N), '='(('[]'(N_objects, enum2int(x))).v, mzn_safe_default(('[]'(N_objects, enum2int(x))).v))) | x in N_potential]);
constraint forall(['\/'('in'(x, P), '='(('[]'(P_objects, enum2int(x))).ns, lb(('[]'(P_objects, enum2int(x))).ns))) | x in P_potential]);
solve satisfy;
