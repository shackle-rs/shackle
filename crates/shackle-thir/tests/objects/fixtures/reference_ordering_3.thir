enum A_potential = {};
array [int] of record(): A_objects = [];
set of A_potential: A = {};
array [A_potential] of string: A_ids = [];
set of A_potential: A_data_objects = {};
opt string: a;
opt A: a_ref = if occurs(a) then mzn_object_from_id(A_ids, A_data_objects, deopt(a), "A") else <> endif;
opt string: b;
opt A: b_ref = if occurs(b) then mzn_object_from_id(A_ids, A_data_objects, deopt(b), "A") else <> endif;
constraint '<'(a_ref, b_ref);
constraint '<='(a_ref, b_ref);
constraint '>'(a_ref, b_ref);
constraint '>='(a_ref, b_ref);
solve satisfy;
