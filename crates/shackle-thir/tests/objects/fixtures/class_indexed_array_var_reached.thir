enum A_potential = A_occ_0({1}) ++ A_occ_1({1});
array [int] of record(var '..'(0, 10): x): A_objects = '++'(A_a1_objects, A_a2_objects);
set of A_potential: A = array_union([A_occ_0({1}), A_occ_1({1})]);
array [A_potential] of string: A_ids = array1d(A_potential, '++'(["a1"], ["a2"]));
array [{1}] of record(var '..'(0, 10): x): A_a1_storage :: (no_output);
int: A_a1_root_start = 1;
int: A_a1_root_end = 2;
array [int] of record(var '..'(0, 10): x): A_a1_objects = A_a1_storage;
A_potential: a1_ref :: (no_output) = A_occ_0(1);
array [{1}] of record(var '..'(0, 10): x): A_a2_storage :: (no_output);
array [int] of record(var '..'(0, 10): x): A_a2_objects = A_a2_storage;
A_potential: a2_ref :: (no_output) = A_occ_1(1);
array [A_potential] of var '..'(0, 10): scores_ref :: (no_output);
constraint forall(['<='('[]'(scores_ref, a), ('[]'(A_objects, enum2int(a))).x) | a in A]);
record(string: id, int: x): a1 :: (output_only) :: ('output') = (id: '[]'(A_ids, a1_ref), x: fix(('[]'(A_objects, enum2int(a1_ref))).x));
record(string: id, int: x): a2 :: (output_only) :: ('output') = (id: '[]'(A_ids, a2_ref), x: fix(('[]'(A_objects, enum2int(a2_ref))).x));
array [A_potential] of int: scores :: (output_only) :: ('output') = fix(scores_ref);
solve satisfy;
