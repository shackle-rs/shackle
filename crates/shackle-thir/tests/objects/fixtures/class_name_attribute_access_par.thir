enum A_potential = A_occ_0({1}) ++ A_occ_1({1});
array [int] of record(int: x): A_objects = '++'(A_a1_objects, A_a2_objects);
set of A_potential: A = array_union([A_occ_0({1}), A_occ_1({1})]);
array [A_potential] of string: A_ids = array1d(A_potential, '++'(["a1"], ["a2"]));
array [int] of record(int: x): A_a1_inputs = [(x: 1)];
int: A_a1_root_start = 1;
int: A_a1_root_end = 2;
array [int] of record(int: x): A_a1_objects = A_a1_inputs;
A_potential: a1_ref :: (no_output) = A_occ_0(1);
array [int] of record(int: x): A_a2_inputs = [(x: 2)];
array [int] of record(int: x): A_a2_objects = A_a2_inputs;
A_potential: a2_ref :: (no_output) = A_occ_1(1);
array [A_potential] of int: ys = [_DECL_1: ('[]'(A_objects, enum2int(_DECL_1))).x | _DECL_1 in A];
array [A_potential] of int: zs = [_DECL_2: ('[]'(A_objects, enum2int(_DECL_2))).x | _DECL_2 in A];
output [concat(["[", join(", ", [concat([show('[]'(A_ids, _DECL_3)), ": ", show('[]'(ys, _DECL_3))]) | _DECL_3 in A]), "]"]), " ", concat(["[", join(", ", [concat([show('[]'(A_ids, _DECL_4)), ": ", show('[]'(zs, _DECL_4))]) | _DECL_4 in A]), "]"]), " ", show('[]'(ys, a2_ref))];
record(string: id, int: x): a1 :: (output_only) :: ('output') = (id: '[]'(A_ids, a1_ref), x: ('[]'(A_objects, enum2int(a1_ref))).x);
record(string: id, int: x): a2 :: (output_only) :: ('output') = (id: '[]'(A_ids, a2_ref), x: ('[]'(A_objects, enum2int(a2_ref))).x);
solve satisfy;
