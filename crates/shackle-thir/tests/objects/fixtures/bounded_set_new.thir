int: n;
enum A_potential = A_occ_0('..'(1, n));
array [int] of record(var '..'(0, 2): x): A_objects = A_as_objects;
var set of A_potential: A = as_ref;
array [A_potential] of string: A_ids = array1d(A_potential, ['++'('++'("as[", show(p)), "]") | p in '..'(1, card('..'(1, n)))]);
array ['..'(1, n)] of record(var '..'(0, 2): x): A_as_storage;
array [int] of record(var '..'(0, 2): x): A_as_objects = A_as_storage;
var set( '..'(0, n) ) of  A_occ_0('..'(1, n)): as_ref :: (no_output);
constraint forall(['\/'('in'(x, A), '='(('[]'(A_objects, enum2int(x))).x, mzn_safe_default(('[]'(A_objects, enum2int(x))).x))) | x in A_potential]);
array [int] of record(string: id, int: x): as :: (output_only) :: ('output') = [(id: '[]'(A_ids, _DECL_1), x: fix(('[]'(A_objects, enum2int(_DECL_1))).x)) | _DECL_1 in fix(as_ref)];
solve satisfy;
