record(string: id, int: x, array [int] of int: ys): b2 :: (output_only) :: ('output') = (id: '[]'(B_ids, b2_ref), x: ('[]'(B_objects, enum2int(b2_ref))).x, ys: ('[]'(B_objects, enum2int(b2_ref))).ys);
