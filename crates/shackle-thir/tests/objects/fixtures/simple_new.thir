enum A_potential = A_occ_0({1});
array [int] of record(var '..'(0, 2): x): A_objects = A_a_objects;
set of A_potential: A = A_occ_0({1});
array [A_potential] of string: A_ids = array1d(A_potential, ["a"]);
array [{1}] of record(var '..'(0, 2): x): A_a_storage :: (no_output);
array [int] of record(var '..'(0, 2): x): A_a_objects = A_a_storage;
A_potential: a_ref :: (no_output) = A_occ_0(1);
record(string: id, int: x): a :: (output_only) :: ('output') = (id: '[]'(A_ids, a_ref), x: fix(('[]'(A_objects, enum2int(a_ref))).x));
solve satisfy;
