enum A_potential = {};
array [int] of record(): A_objects = [];
set of A_potential: A = {};
array [A_potential] of string: A_ids = [];
set of A_potential: A_data_objects = {};
string: a;
A: a_ref = mzn_object_from_id(A_ids, A_data_objects, a, "A");
string: b;
A: b_ref = mzn_object_from_id(A_ids, A_data_objects, b, "A");
opt string: oa;
opt A: oa_ref = if occurs(oa) then mzn_object_from_id(A_ids, A_data_objects, deopt(oa), "A") else <> endif;
set of A_potential: span = '..'(a_ref, b_ref);
constraint 'in'(a_ref, enum_of(a_ref));
constraint 'in'(b_ref, span);
constraint '\/'(absent(oa_ref), 'in'(deopt(oa_ref), enum_of(oa_ref)));
solve satisfy;
