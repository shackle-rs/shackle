enum B_potential = {};
array [int] of record(): B_objects = [];
set of B_potential: B = {};
array [B_potential] of string: B_ids = [];
enum A_potential = {};
array [int] of record(): A_objects = [];
set of A_potential: A = {};
array [A_potential] of string: A_ids = [];
A: a;
B: b;
constraint '<'(enum2int(a), enum2int(b));
constraint '<='(enum2int(a), enum2int(b));
constraint '>'(enum2int(a), enum2int(b));
constraint '>='(enum2int(a), enum2int(b));
solve satisfy;
