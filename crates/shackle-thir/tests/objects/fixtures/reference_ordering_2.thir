enum B_potential = {};
array [int] of record(): B_objects = [];
set of B_potential: B = {};
array [B_potential] of string: B_ids = [];
set of B_potential: B_data_objects = {};
enum A_potential = {};
array [int] of record(): A_objects = [];
set of A_potential: A = {};
array [A_potential] of string: A_ids = [];
set of A_potential: A_data_objects = {};
string: a;
A: a_ref = mzn_object_from_id(A_ids, A_data_objects, a, "A");
string: b;
B: b_ref = mzn_object_from_id(B_ids, B_data_objects, b, "B");
constraint '<'(enum2int(a_ref), enum2int(b_ref));
constraint '<='(enum2int(a_ref), enum2int(b_ref));
constraint '>'(enum2int(a_ref), enum2int(b_ref));
constraint '>='(enum2int(a_ref), enum2int(b_ref));
solve satisfy;
