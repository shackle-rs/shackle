enum A_potential = A_occ_0({1, 2});
array [int] of record('..'(0, 10): x): A_objects = A_as_objects;
set of A_potential: A = as;
array [A_potential] of string: A_ids = array1d(A_potential, ['++'('++'("as[", show(p)), "]") | p in '..'(1, card({1, 2}))]);
enum B_potential = B_occ_1({1});
array [int] of record(var A_potential: r, var '..'(1, 2): y): B_objects = B_b_objects;
set of B_potential: B = B_occ_1({1});
array [B_potential] of string: B_ids = array1d(B_potential, ["b"]);
array [int] of record(int: x): A_as_inputs = [(x: 3), (x: 4)];
int: A_as_root_start = 1;
int: A_as_root_end = 3;
array [int] of record('..'(0, 10): x): A_as_objects = A_as_inputs;
set of A_occ_0({1, 2}): as = A_occ_0({1, 2});
array [{1}] of record(var A_potential: r, var '..'(1, 2): y): B_b_storage :: (no_output);
array [int] of record(var A_potential: r, var '..'(1, 2): y): B_b_objects = [(r: r, y: y) | p in index_set(B_b_storage), input = '[]'(B_b_storage, p), r = (input).r, y = (input).y];
B_potential: b_ref :: (no_output) = B_occ_1(1);
var A: chosen_ref :: (no_output);
array [A_potential] of var '..'(0, 10): scores_ref :: (no_output);
array [A_potential, '..'(1, 2)] of var '..'(0, 1): grid_ref :: (no_output);
constraint '='('[]'(scores_ref, chosen_ref), 7);
constraint '='('[]'(scores_ref, ('[]'(B_objects, enum2int(b_ref))).r), ('[]'(A_objects, enum2int(('[]'(B_objects, enum2int(b_ref))).r))).x);
constraint '='(sum(['[]'(grid_ref, (a, j)) | a in A, j in '..'(1, 2)]), 1);
output [show(fix(scores_ref)), concat([" chosen=", show('[]'(A_ids, fix(chosen_ref)))])];
record(string: id, string: r, int: y): b :: (output_only) :: ('output') = (id: '[]'(B_ids, b_ref), r: '[]'(A_ids, fix(('[]'(B_objects, enum2int(b_ref))).r)), y: fix(('[]'(B_objects, enum2int(b_ref))).y));
string: chosen :: (output_only) :: ('output') = '[]'(A_ids, fix(chosen_ref));
array [A_potential] of int: scores :: (output_only) :: ('output') = fix(scores_ref);
array [A_potential, int] of int: grid :: (output_only) :: ('output') = fix(grid_ref);
solve satisfy;
