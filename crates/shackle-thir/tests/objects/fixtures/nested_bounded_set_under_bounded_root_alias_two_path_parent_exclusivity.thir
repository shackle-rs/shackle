array [B_occ_1('..'(1, '*'(card(A_potential), max('..'(0, n)))))] of record(var '..'(0, 2): y): B_bs_objects;
array [B_occ_2('..'(1, '*'(card(A_potential), max('..'(0, n)))))] of record(var '..'(0, 2): y): B_cs_objects;
