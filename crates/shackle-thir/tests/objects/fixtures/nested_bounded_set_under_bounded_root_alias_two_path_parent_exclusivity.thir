constraint forall(['\/'('in'(x, A), '='(('[]'(A_objects, enum2int(x))).cs, lb(('[]'(A_objects, enum2int(x))).cs))) | x in A_potential]);
array [int] of record(array [int] of record(string: id, int: y): bs, array [int] of record(string: id, int: y): cs, string: id): as :: (output_only) :: ('output') = [(id: '[]'(A_ids, _DECL_7), bs: [(id: '[]'(B_ids, _DECL_8), y: fix(('[]'(B_objects, enum2int(_DECL_8))).y)) | _DECL_8 in fix(('[]'(A_objects, enum2int(_DECL_7))).bs)], cs: [(id: '[]'(B_ids, _DECL_9), y: fix(('[]'(B_objects, enum2int(_DECL_9))).y)) | _DECL_9 in fix(('[]'(A_objects, enum2int(_DECL_7))).cs)]) | _DECL_7 in fix(as_ref)];
solve satisfy;
