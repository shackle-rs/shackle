int: m;
int: n;
enum B_potential = B_occ_1('..'(1, '*'(card(A_potential), max('..'(0, n))))) ++ B_occ_2('..'(1, '*'(card(A_potential), max('..'(0, n)))));
array [int] of record(var '..'(0, 2): y): B_objects = '++'(B_bs_objects, B_cs_objects);
