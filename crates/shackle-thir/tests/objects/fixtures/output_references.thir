enum A_potential = A_occ_0({1, 2});
array [int] of record('..'(1, 3): x): A_objects = A_as_objects;
set of A_potential: A = as;
array [A_potential] of string: A_ids = array1d(A_potential, ['++'('++'("as[", show(p)), "]") | p in '..'(1, card({1, 2}))]);
enum B_potential = B_occ_1({1});
array [int] of record(var A_potential: a, var '..'(1, 2): y): B_objects = B_b_objects;
set of B_potential: B = B_occ_1({1});
array [B_potential] of string: B_ids = array1d(B_potential, ["b"]);
array [int] of record(int: x): A_as_inputs = [(x: 1), (x: 2)];
int: A_as_root_start = 1;
int: A_as_root_end = 3;
array [int] of record('..'(1, 3): x): A_as_objects = A_as_inputs;
set of A_occ_0({1, 2}): as = A_occ_0({1, 2});
array [{1}] of record(var A_potential: a, var '..'(1, 2): y): B_b_storage :: (no_output);
array [int] of record(var A_potential: a, var '..'(1, 2): y): B_b_objects = [(a: a, y: y) | p in index_set(B_b_storage), input = '[]'(B_b_storage, p), a = (input).a, y = (input).y];
B_potential: b_ref :: (no_output) = B_occ_1(1);
var A: chosen_ref :: (no_output);
var opt A: maybe_ref :: (no_output);
array ['..'(1, 2)] of var A_potential: pair_ref :: (no_output);
output ["chosen=", show('[]'(A_ids, fix(chosen_ref))), concat([" b.a=", show('[]'(A_ids, fix(('[]'(B_objects, enum2int(b_ref))).a))), "\n"])];
record(string: a, string: id, int: y): b :: (output_only) :: ('output') = (id: '[]'(B_ids, b_ref), a: '[]'(A_ids, fix(('[]'(B_objects, enum2int(b_ref))).a)), y: fix(('[]'(B_objects, enum2int(b_ref))).y));
string: chosen :: (output_only) :: ('output') = '[]'(A_ids, fix(chosen_ref));
opt string: maybe :: (output_only) :: ('output') = if occurs(fix(maybe_ref)) then '[]'(A_ids, deopt(fix(maybe_ref))) else <> endif;
array [int] of string: pair :: (output_only) :: ('output') = arrayXd(fix(pair_ref), ['[]'(A_ids, _DECL_1) | _DECL_1 in fix(pair_ref)]);
solve satisfy;
