enum A_potential = A_occ_0('..'(1, 3));
array [int] of record(var '..'(1, 3): x): A_objects = A_as_objects;
var set of A_potential: A = as_ref;
array [A_potential] of string: A_ids = array1d(A_potential, ['++'('++'("as[", show(p)), "]") | p in '..'(1, card('..'(1, 3)))]);
enum C_potential = C_occ_1({1});
array [int] of record('..'(1, 3): y): C_objects = C_cs_objects;
set of C_potential: C = cs;
array [C_potential] of string: C_ids = array1d(C_potential, ['++'('++'("cs[", show(p)), "]") | p in '..'(1, card({1}))]);
enum B_potential = B_occ_2({1});
array [int] of record(var A_potential: a, var set of A_potential: as_, var C_potential: c): B_objects = B_b_objects;
set of B_potential: B = B_occ_2({1});
array [B_potential] of string: B_ids = array1d(B_potential, ["b"]);
array ['..'(1, 3)] of record(var '..'(1, 3): x): A_as_storage;
array [int] of record(var '..'(1, 3): x): A_as_objects = A_as_storage;
var set( '..'(0, 3) ) of  A_occ_0('..'(1, 3)): as_ref :: (no_output);
array [int] of record(int: y): C_cs_inputs = [(y: 1)];
int: C_cs_root_start = 1;
int: C_cs_root_end = 2;
array [int] of record('..'(1, 3): y): C_cs_objects = C_cs_inputs;
set of C_occ_1({1}): cs = C_occ_1({1});
array [{1}] of record(var A_potential: a, var set of A_potential: as_, var C_potential: c): B_b_storage :: (no_output);
array [int] of record(var A_potential: a, var set of A_potential: as_, var C_potential: c): B_b_objects = [(a: a, as_: as_, c: c) | p in index_set(B_b_storage), input = '[]'(B_b_storage, p), a = (input).a, as_ = (input).as_, c = (input).c];
B_potential: b :: (no_output) = B_occ_2(1);
var A_potential: one :: (no_output);
var opt A_potential: maybe :: (no_output);
var set of A_potential: picked :: (no_output);
array ['..'(1, 2)] of var A_potential: two :: (no_output);
var C: other :: (no_output);
var set of C_potential: others :: (no_output);
constraint forall(['\/'('in'(x, A), '='(('[]'(A_objects, enum2int(x))).x, mzn_safe_default(('[]'(A_objects, enum2int(x))).x))) | x in A_potential]);
constraint 'in'(one, A);
constraint '->'(occurs(maybe), 'in'(deopt(maybe), A));
constraint 'subset'(enum2int(picked), enum2int(A));
constraint forall(['in'(_DECL_1, A) | _DECL_1 in two]);
constraint forall(['in'(('[]'(B_objects, enum2int(_DECL_2))).a, A) | _DECL_2 in B]);
constraint forall(['subset'(enum2int(('[]'(B_objects, enum2int(_DECL_3))).as_), enum2int(A)) | _DECL_3 in B]);
array [int] of record(string: id, int: x): as :: (output_only) :: ('output') = [(id: '[]'(A_ids, _DECL_4), x: fix(('[]'(A_objects, enum2int(_DECL_4))).x)) | _DECL_4 in fix(as_ref)];
solve satisfy;
