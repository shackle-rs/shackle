enum B_potential = B_occ_1('..'(1, '*'(card(R_potential), max('..'(0, 1)))));
array [int] of record(var '..'(0, 1): y): B_objects = array1d(B_bs_objects);
var set of B_potential: B = array_union([('[]'(R_r_objects, _DECL_1)).bs | _DECL_1 in index_set(R_r_objects)]);
enum R_potential = R_occ_0({1});
array [int] of record(var set of B_potential: bs): R_objects = R_r_objects;
set of R_potential: R = R_occ_0({1});
constraint forall(['in'(card(('[]'(R_objects, enum2int(this))).bs), '..'(0, 1)) | this in R]);
enum A_potential = A_occ_1('..'(1, '*'(card(R_potential), max('..'(0, 1)))));
array [int] of record(var '..'(0, 1): y): A_objects = A_bs_objects;
var set of A_potential: A = array_union([if 'in'(_DECL_2, B) then {A_occ_1(enum2int(_DECL_2))} else {} endif | _DECL_2 in index_set(B_bs_objects)]);
constraint forall(['='(card(('[]'(R_objects, enum2int(r))).bs), 0) | r in R]);
array [{1}] of record(var set of B_potential: bs): R_r_storage;
array [B_occ_1('..'(1, '*'(card(R_potential), max('..'(0, 1)))))] of record(var '..'(0, 1): y): B_bs_objects;
array [int] of record(var '..'(0, 1): y): A_bs_objects = [(y: (proj).y) | proj in B_bs_objects];
int: R_r_bs_A_start = 1;
int: R_r_bs_A_end = 2;
int: R_r_bs_start = 1;
int: R_r_bs_end = '+'(R_r_bs_start, '*'(card(R_potential), max('..'(0, 1))));
array [int] of set of B_potential: R_r_bs_potential = [_DECL_3: B_occ_1('..'('+'(1, '*'('-'(_DECL_3, 1), max('..'(0, 1)))), '*'(_DECL_3, max('..'(0, 1))))) | _DECL_3 in index_set(R_r_storage)];
array [int] of record(var set of B_potential: bs): R_r_objects = [(bs: bs) | p in index_set(R_r_storage), input = '[]'(R_r_storage, p), bs = (input).bs];
R_potential: r = R_occ_0(1);
constraint forall(['subset'(enum2int(('[]'(R_r_objects, _DECL_4)).bs), enum2int('[]'(R_r_bs_potential, _DECL_4))) | _DECL_4 in index_set(R_r_objects)]);
output ["nA=", show(card(fix(A))), " nB=", show(card(fix(B)))];
constraint forall(['\/'('in'(x, A), '='(('[]'(A_objects, enum2int(x))).y, mzn_safe_default(('[]'(A_objects, enum2int(x))).y))) | x in A_potential]);
constraint forall(['\/'('in'(x, B), '='(('[]'(B_objects, enum2int(x))).y, mzn_safe_default(('[]'(B_objects, enum2int(x))).y))) | x in B_potential]);
solve satisfy;
