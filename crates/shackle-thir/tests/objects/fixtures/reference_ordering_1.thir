enum A_potential = {};
array [int] of record(): A_objects = [];
set of A_potential: A = {};
array [A_potential] of string: A_ids = [];
set of A_potential: A_data_objects = {};
string: a;
A: a_ref = mzn_object_from_id(A_ids, A_data_objects, a, "A");
string: b;
A: b_ref = mzn_object_from_id(A_ids, A_data_objects, b, "A");
constraint '<'(a_ref, b_ref);
constraint '<='(a_ref, b_ref);
constraint '>'(a_ref, b_ref);
constraint '>='(a_ref, b_ref);
solve satisfy;
